/* ============ 大图预览浮层 ============ */

/* 全屏黑底浮层，z-index 60（低于宿主 toast 的 80，高于底部操作条的 40） */
.vw-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #0b0b0c;
  z-index: 60;
  display: flex;
  flex-direction: column;
  animation: scrIn .2s ease both;
}

/* 头部：padding-top 由内联的 statusBarH（真实 px）补上 */
.vw-head {
  padding: 0 36rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
}

.vw-head-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vw-close-ic {
  width: 38rpx;
  height: 38rpx;
  color: #fff;
}

.vw-pos {
  font-size: 28rpx;
  font-weight: 700;
}

/* 选择圆钮：未选中是半透明白底 + 白描边，选中换 accent 底并显示 ✓ */
.vw-sel {
  border: 3rpx solid rgba(255, 255, 255, .7);
  color: var(--onAccent);
  font-size: 30rpx;
  font-weight: 800;
}

.vw-sel-on {
  background: var(--accent);
  border-color: var(--accent);
}

/* 中部看图区 */
.vw-stage {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.vw-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 左右透明点击区：各占 34% 宽、全高，点了翻上一张/下一张 */
.vw-zone {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 34%;
}

.vw-zone-l {
  left: 0;
}

.vw-zone-r {
  right: 0;
}

/* 底部保存栏 */
.vw-foot {
  padding: 28rpx 40rpx 60rpx;
}

.vw-save {
  width: 100%;
  padding: 28rpx;
  background: var(--accent);
  color: var(--onAccent);
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.vw-save-ic {
  width: 34rpx;
  height: 34rpx;
}
