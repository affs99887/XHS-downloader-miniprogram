/* 解析中屏（前缀 ps-） */

.ps-page {
  min-height: 100%;
  background: var(--bg);
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx 68rpx 140rpx;
  box-sizing: border-box;
}

/* 整块内容一起做上浮入场 */
.ps-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: riseIn .46s cubic-bezier(.22, .61, .36, 1) both;
}

/* ===== 文档扫描动效 ===== */

.ps-anim {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 两个圆环叠在同一位置，靠动画向外扩散；第二个延迟半拍，形成一圈接一圈的效果 */
.ps-ring {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 50%;
  border: 3rpx solid var(--accent);
  animation: eb-ring 1.9s ease-out infinite;
}

.ps-ring2 {
  animation-delay: .95s;
}

/* 白色小文档卡 */
.ps-doc {
  width: 184rpx;
  height: 228rpx;
  border-radius: 16rpx;
  background: var(--cream);
  box-shadow: 0 36rpx 76rpx -28rpx rgba(0, 0, 0, .55);
  overflow: hidden;
  position: relative;
  padding: 22rpx;
  box-sizing: border-box;
}

/* 头图占位块：淡底 + 45 度斜纹（repeating-linear-gradient 就是重复条纹渐变） */
.ps-doc-head {
  height: 88rpx;
  border-radius: 10rpx;
  background-color: rgba(20, 40, 28, .05);
  background-image: repeating-linear-gradient(135deg, rgba(20, 40, 28, .1) 0 3rpx, transparent 3rpx 18rpx);
}

/* 三条模拟正文的灰色短线，宽度各不相同 */
.ps-doc-line {
  height: 10rpx;
  border-radius: 4rpx;
  background: rgba(20, 40, 28, .1);
  margin-top: 12rpx;
}

.ps-l1 {
  margin-top: 20rpx;
  width: 82%;
}

.ps-l2 {
  width: 56%;
}

.ps-l3 {
  width: 70%;
}

/* 顶部的渐变扫描条，从上往下来回扫 */
.ps-doc-scan {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 32rpx;
  background: linear-gradient(180deg, var(--accent), transparent);
  opacity: .65;
  animation: eb-scan 1.5s linear infinite;
}

/* ===== 短链展示 ===== */

.ps-url {
  font-size: 22rpx;
  color: var(--mint);
  margin-top: 36rpx;
  opacity: .85;
}

/* ===== 进度区 ===== */

.ps-prog {
  width: 100%;
  margin-top: 52rpx;
}

.ps-prog-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.ps-prog-step {
  font-size: 26rpx;
  color: var(--mint);
}

.ps-prog-pct {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
}

.ps-track {
  height: 4rpx;
  background: rgba(255, 255, 255, .14);
  position: relative;
  overflow: hidden;
}

/* 宽度由内联 style 按百分比控制，这里只管过渡 */
.ps-bar {
  height: 100%;
  background: var(--accent);
  transition: width .12s linear;
}

/* ===== 步骤清单 ===== */

.ps-steps {
  width: 100%;
  margin-top: 40rpx;
}

.ps-step-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, .1);
}

/* 序号与文字默认是暗色，进行中/已完成时点亮（加 ps-on 类） */
.ps-step-folio {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, .42);
  width: 36rpx;
  margin-right: 24rpx;
}

.ps-step-folio.ps-on {
  color: var(--accent);
}

.ps-step-label {
  flex: 1;
  font-size: 29rpx;
  color: rgba(255, 255, 255, .42);
}

.ps-step-label.ps-on {
  color: #fff;
}

.ps-step-check {
  color: var(--accent);
  font-size: 28rpx;
  margin-left: 24rpx;
}

/* 进行中的旋转小圆环：右、上两边框透明，转起来就是缺口在跑 */
.ps-step-spin {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 3rpx solid var(--accent);
  border-right-color: transparent;
  border-top-color: transparent;
  animation: eb-spin .8s linear infinite;
  margin-left: 24rpx;
  box-sizing: border-box;
}
